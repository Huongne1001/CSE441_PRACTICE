<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <ImageView
        android:id="@+id/cart_item_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/cart_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tên sản phẩm"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/cart_item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="8dp" />

    <TextView
        android:id="@+id/cart_item_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Giá sản phẩm"
        app:layout_constraintStart_toEndOf="@id/cart_item_image"
        app:layout_constraintTop_toBottomOf="@id/cart_item_name"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="8dp" />

    <TextView
        android:id="@+id/cart_item_quantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Số lượng: 1"
        app:layout_constraintStart_toEndOf="@id/cart_item_image"
        app:layout_constraintTop_toBottomOf="@id/cart_item_price"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="8dp" />

    <Button
        android:id="@+id/btn_decrease_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        app:layout_constraintStart_toEndOf="@+id/cart_item_image"
        app:layout_constraintTop_toBottomOf="@+id/cart_item_quantity" />

    <TextView
        android:id="@+id/tv_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="1"
        app:layout_constraintStart_toEndOf="@+id/btn_decrease_quantity"
        app:layout_constraintTop_toBottomOf="@+id/cart_item_quantity" />

    <Button
        android:id="@+id/btn_increase_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="+"
        app:layout_constraintStart_toEndOf="@+id/tv_quantity"
        app:layout_constraintTop_toBottomOf="@+id/cart_item_quantity" />

</androidx.constraintlayout.widget.ConstraintLayout>
